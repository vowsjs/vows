{
  "name": "vows",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "testing framework",
  "keywords": [
    "unit test",
    "vows",
    "test"
  ],
  "author": {
    "name": "Evan Prodromou",
    "email": "evan@fuzzy.ai"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "./assert": {
      "types": "./dist/assert.d.ts",
      "default": "./src/assert.js"
    }
  },
  "bin": {
    "vows": "./bin/vows.js"
  },
  "scripts": {
    "test": "node --test ./test/*.test.js",
    "test:coverage": "c8 node --test ./test/*.test.js",
    "build:types": "tsc",
    "lint": "biome lint src test bin",
    "lint:fix": "biome lint --write src test bin",
    "lint:md": "markdownlint-cli2 \"README.md\"",
    "format": "biome format --write src test bin",
    "format:check": "biome format src test bin",
    "check": "biome check src test bin && pnpm run build:types",
    "check:fix": "biome check --write src test bin",
    "prepublishOnly": "pnpm run build:types"
  },
  "files": [
    "bin/*",
    "src/*",
    "dist/*",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": "vowsjs/vows",
  "dependencies": {
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.2.1",
    "c8": "^10.1.3",
    "markdownlint-cli2": "^0.17.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.1",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  }
}
